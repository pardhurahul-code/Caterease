# ==============================================================================
# CaterEase Environment Configuration
# ==============================================================================
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:3000

# Cloud SQL / PostgreSQL Connection Variables (Object Method)
SQL_HOST=127.0.0.1
SQL_DB_NAME=caterease
SQL_USER=caterease_user
SQL_PASSWORD=your_sql_user_password
SQL_ADMIN_USER=postgres
SQL_ADMIN_PASSWORD=your_sql_admin_password

# Authentication & Security
JWT_SECRET=replace_with_a_long_random_jwt_secret_key

# Google Gemini AI (Server-side only — never expose in frontend)
# Obtain from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# Google Maps Platform (Maps JavaScript, Places API New, Routes API)
VITE_GOOGLE_MAPS_API_KEY=

# Razorpay Payment Gateway (Leave blank to run in clearly labelled DEMO PAYMENT MODE)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Nodemailer SMTP Email Configuration (Optional — falls back to in-app notification log)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=CaterEase <no-reply@caterease.local>

# Hosted App URL
APP_URL=http://localhost:3000
